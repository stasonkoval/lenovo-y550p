[Unit]
Description=Lenovo IdeaPad Y550P EC fan controller
After=systemd-modules-load.service
ConditionArchitecture=x86-64
ConditionPathExists=/sys/class/dmi/id/product_name

[Service]
Type=simple
ExecStart=/usr/local/sbin/y550p-fand
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
KillSignal=SIGTERM
RuntimeDirectory=y550p-fan
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0022

# The daemon needs raw I/O only for the ENE EC index ports.
CapabilityBoundingSet=CAP_SYS_RAWIO
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectHostname=true
ProtectClock=true
PrivateTmp=true
PrivateNetwork=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
